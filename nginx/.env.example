# Configuration pour docker-compose

# Keycloak Admin
KEYCLOAK_ADMIN_PASSWORD=votre_mot_de_passe_admin_fort

# WebApp Client Secret (à récupérer depuis Keycloak)
WEBAPP_CLIENT_SECRET=votre_client_secret

# Session Secret (généré aléatoirement)
SESSION_SECRET=votre_session_secret_tres_long_et_aleatoire
